STEAM_API_KEY=your_key_here
STEAM_ID=your_64_bit_steam_id_here
# Optional: your country's two-letter code (e.g. BR), so store prices come in your currency.
# Without it Steam guesses from your connection, and a VPN changes the guess.
STEAM_COUNTRY=
# Optional: for games that aren't on Steam. A free Twitch developer app (dev.twitch.tv/console) gives
# both; IGDB is free for non-commercial use. Without them, only Steam games can be added.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional: each game's lowest price ever on Steam, from IsThereAnyDeal. Register an app at
# isthereanydeal.com/apps/my/ for a key. Without it, prices show without their history.
ITAD_API_KEY=
